# Generated by Ansible from inventory/workstations.yml.
# Included by the map in /etc/nginx/conf.d/autoinstall-otp.conf: each host's
# one-time password may only be fetched from that host's reserved IP.
{% for name, ws in workstations | dictsort %}
/autoinstall/{{ name }}/otp {{ ws.ip }};
{% endfor %}
