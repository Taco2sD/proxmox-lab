#!/usr/bin/env python3
"""/usr/local/libexec/lab-guest-metrics on pve01 (roles/pve_monitoring), run every 30 s by
lab-guest-metrics.timer: what each Proxmox guest is and the limits the host enforces on
it, as metrics for node_exporter's textfile collector (lab-guests.prom). The Machine
dashboard shows them (roles/monitoring: "What it is", "Limits").

Why from pve01: a guest can't reliably see its own kind or limits. A container shares
pve01's kernel and even reads pve01's DMI data (mgmt01's node_exporter reports
"Microsoft Corporation Virtual Machine", which is pve01's Hyper-V), and its limits are set
on its parent cgroup, above what it can see. Here, both are plain files:
  /etc/pve/{lxc,qemu-server}/<vmid>.conf     what was asked for (cores, memory, swap,
                                             cpuunits, cpulimit, unprivileged, features)
  /sys/fs/cgroup/lxc/<vmid>/                 a container's cgroup (cgroup v2)
  /sys/fs/cgroup/qemu.slice/<vmid>.scope/    a VM's QEMU process's cgroup
Every series carries guest (the name, which is the machine's host label elsewhere), vmid
and type (lxc or qemu). In the cgroup values, 0 means "no limit" (the file says max).

Storage, where a container's view misleads most: its /proc/diskstats is pve01's, so its
node_exporter reports every disk of pve01, host-wide. From here:
  lab_host_block_device_info   every pve01 disk device, named for what it is (whose disk,
                               the thin pool, pve01's root or swap), for labelling those
  lab_guest_disk_bytes         each guest's disks: where they appear in the guest, what backs
                               them on pve01 and the device stack under them (thin volume ->
                               thin pool -> physical disk)
A guest's own traffic is its own volumes' traffic, from pve01's node_exporter (only that
guest uses them). Not its cgroup's io.stat: most of a container's writes are written back
by kernel threads outside its cgroup, and io.stat saw under 1% of mgmt01's.
"""
import os
import re
from pathlib import Path

OUT = Path("/var/lib/prometheus/node-exporter/lab-guests.prom")
CG = Path("/sys/fs/cgroup")
KINDS = {"lxc": (Path("/etc/pve/lxc"), lambda v: CG / "lxc" / v),
         "qemu": (Path("/etc/pve/qemu-server"), lambda v: CG / "qemu.slice" / f"{v}.scope")}
MIB = 1024 * 1024


def read(path):
    try:
        return path.read_text().strip()
    except OSError:
        return None


def config(path):
    """The guest's own settings: the part of the file before the first [snapshot]."""
    out = {}
    for line in (read(path) or "").splitlines():
        if line.startswith("["):
            break
        if ":" in line and not line.startswith("#"):
            k, v = line.split(":", 1)
            out[k.strip()] = v.strip()
    return out


def limit(text, scale=1):
    """A cgroup limit file: 'max' is no limit (0 here)."""
    if text is None:
        return None
    return 0 if text.split()[0] == "max" else int(text.split()[0]) * scale


def keyed(text):
    """cpu.stat, memory.events: 'key value' lines."""
    return {k: int(v) for k, v in (line.split() for line in (text or "").splitlines() if len(line.split()) == 2)}


def cpus(text):
    """cpuset.cpus.effective, e.g. 0-1,4: how many CPUs."""
    n = 0
    for part in (text or "").split(","):
        if "-" in part:
            a, b = part.split("-")
            n += int(b) - int(a) + 1
        elif part:
            n += 1
    return n


def isolation(kind, cfg):
    if kind == "lxc":
        feats = [f.split("=")[0] for f in cfg.get("features", "").split(",") if f.endswith("=1")]
        return ("Unprivileged" if cfg.get("unprivileged") == "1" else "Privileged") + \
            " LXC, pve01's kernel" + (f", {', '.join(feats)}" if feats else "")
    return f"KVM, own kernel, CPU type {cfg.get('cpu', 'kvm64').split(',')[0]}"


def blockdev(majmin):
    """'252:9' -> 'dm-9'."""
    try:
        return Path(f"/sys/dev/block/{majmin}").resolve().name
    except OSError:
        return None


def devname(path):
    """The device under a path: /dev/pve/vm-106-disk-0 -> dm-9; a directory -> the device of
    the filesystem it is on."""
    try:
        st = os.stat(path)
    except OSError:
        return None
    rdev = st.st_rdev if Path(path).is_block_device() else st.st_dev
    return blockdev(f"{os.major(rdev)}:{os.minor(rdev)}")


def stack(dev):
    """The devices under a device, down to the physical disk: dm-9 -> dm-4 -> dm-3 -> sda.
    Through a thin pool, follow its data (tdata), not its metadata (tmeta)."""
    chain, seen = [dev], {dev}
    while True:
        base = Path("/sys/class/block") / chain[-1]
        if (base / "partition").exists():                 # sda3 -> sda
            chain[-1] = base.resolve().parent.name
            break
        slaves = sorted(p.name for p in (base / "slaves").glob("*")) if (base / "slaves").is_dir() else []
        if not slaves:
            break
        nxt = next((s for s in slaves if not (read(Path("/sys/class/block") / s / "dm" / "name") or "").endswith("_tmeta")),
                   slaves[0])
        if nxt in seen:
            break
        chain.append(nxt)
        seen.add(nxt)
    return chain


def what_is(dm, names):
    """What a pve01 device is, from its device-mapper name (pve-vm--106--disk--0)."""
    m = re.match(r"pve-(vm|base)--(\d+)--(disk--(\d+)|cloudinit|state--suspend--.*)$", dm)
    if m:
        owner = names.get(m.group(2), f"guest {m.group(2)}")
        part = m.group(3)
        what = ("cloud-init" if part == "cloudinit" else "hibernation image" if part.startswith("state")
                else f"disk {m.group(4)}")
        return owner, f"{owner} {'image ' if m.group(1) == 'base' else ''}{what}"
    fixed = {"pve-root": "pve01 root", "pve-swap": "pve01 swap", "pve-data": "thin pool",
             "pve-data-tpool": "thin pool", "pve-data_tdata": "thin pool data", "pve-data_tmeta": "thin pool metadata"}
    return "pve01", fixed.get(dm, "pve01 physical disk")


def dir_bytes(path):
    """Disk space a directory's files take (du -s)."""
    total = 0
    for root, _, files in os.walk(path):
        for f in files:
            try:
                total += os.lstat(os.path.join(root, f)).st_blocks * 512
            except OSError:
                pass
    return total


def dev_bytes(dev):
    return int(read(Path("/sys/class/block") / dev / "size") or 0) * 512


def guest_disks(kind, cfg):
    """Per disk: (where it shows in the guest, what backs it on pve01, pve01 device, bytes,
    whether it's the guest's own). Bytes: an own volume's size; a bind mount's contents (the
    device is all of pve01's filesystem); swap: what a container may use of pve01's."""
    out = []
    for key, val in cfg.items():
        src = val.split(",")[0]
        vol = src.split(":", 1)[-1]
        if kind == "lxc" and (key == "rootfs" or re.fullmatch(r"mp\d+", key)):
            where = "/" if key == "rootfs" else (re.search(r"mp=([^,]+)", val) or [None, key])[1]
            ro = ", read-only" if "ro=1" in val else ""
            if src.startswith("/"):                       # bind mount of a pve01 directory
                out.append((where, f"pve01:{src}{ro}", devname(src), dir_bytes(src), False))
            elif ":" in src:
                dev = devname(f"/dev/pve/{vol}")
                out.append((where, f"own volume {vol}{ro}", dev, dev and dev_bytes(dev), True))
        elif kind == "qemu" and re.fullmatch(r"(scsi|virtio|sata|ide|efidisk|tpmstate)\d+", key) and ":" in src:
            if "media=cdrom" in val and "cloudinit" not in src:
                continue
            where = f"{key} (cloud-init)" if "cloudinit" in src else key
            dev = devname(f"/dev/pve/{vol}")
            out.append((where, f"own volume {vol}", dev, dev and dev_bytes(dev), True))
    if kind == "lxc" and int(cfg.get("swap", 512)) > 0:
        swaps = (read(Path("/proc/swaps")) or "").splitlines()[1:]
        if swaps:
            out.append(("swap", "pve01's swap", devname(swaps[0].split()[0]), int(cfg.get("swap", 512)) * MIB, False))
    return [d for d in out if d[2]]


class Out:
    def __init__(self):
        self.metrics = {}

    def add(self, name, help_text, labels, value, kind="gauge"):
        if value is None:
            return
        m = self.metrics.setdefault(name, (help_text, kind, []))
        esc = lambda v: str(v).replace("\\", "\\\\").replace('"', '\\"')  # noqa: E731
        m[2].append("{" + ",".join(f'{k}="{esc(v)}"' for k, v in labels.items()) + f"}} {value}")

    def text(self):
        out = []
        for name, (h, kind, samples) in self.metrics.items():
            out += [f"# HELP {name} {h}", f"# TYPE {name} {kind}"] + [name + s for s in samples]
        return "\n".join(out) + "\n"


def main():
    o = Out()
    names, mounts = {}, {}                            # vmid -> name; device -> "guest: where"
    for kind, (confdir, _) in KINDS.items():
        for conf in confdir.glob("*.conf"):
            cfg = config(conf)
            names[conf.stem] = cfg.get("hostname" if kind == "lxc" else "name", conf.stem)
    for kind, (confdir, cgdir) in KINDS.items():
        for conf in sorted(confdir.glob("*.conf")):
            vmid = conf.stem
            cfg = config(conf)
            if cfg.get("template") == "1":
                continue                                  # golden images: never run
            name = cfg.get("hostname" if kind == "lxc" else "name", vmid)
            L = {"guest": name, "vmid": vmid, "type": kind}
            o.add("lab_guest_config_info", "Each guest as Proxmox defines it (value always 1).",
                  {**L, "isolation": isolation(kind, cfg), "unprivileged": cfg.get("unprivileged", ""),
                   "features": cfg.get("features", ""), "ostype": cfg.get("ostype", "")}, 1)
            o.add("lab_guest_id", "The guest's Proxmox ID (VMID) as a value, for showing it.", L, int(vmid))
            sockets = int(cfg.get("sockets", 1))
            o.add("lab_guest_config_cores", "CPU cores the guest is given.", L, int(cfg.get("cores", 1)) * sockets)
            o.add("lab_guest_config_memory_bytes", "Memory the guest is given.", L, int(cfg.get("memory", 512)) * MIB)
            if kind == "lxc":
                o.add("lab_guest_config_swap_bytes", "Swap a container may use.", L, int(cfg.get("swap", 512)) * MIB)
            o.add("lab_guest_config_cpu_units", "CPU weight under contention (cpuunits; 100 is the default).",
                  L, int(cfg.get("cpuunits", 100)))
            o.add("lab_guest_config_cpu_limit_cores", "Hard CPU cap in cores (cpulimit; 0: none).",
                  L, float(cfg.get("cpulimit", 0)))

            for where, source, dev, size, own in guest_disks(kind, cfg):
                if own:                                   # pve01's devices it shares keep pve01's names
                    mounts.setdefault(dev, f"{name} {where}")
                o.add("lab_guest_disk_bytes", "Each guest disk: where it shows in the guest, what backs it on "
                      "pve01, the device stack under it (value: an own volume's size, a bind mount's "
                      "contents, a container's swap limit).",
                      {**L, "mount": where, "source": source, "device": dev, "own": str(own).lower(),
                       "chain": " > ".join(stack(dev))}, size)

            d = cgdir(vmid)
            if not d.is_dir():                            # not running: no cgroup
                continue
            o.add("lab_guest_running", "1 while the guest has a cgroup on pve01 (it is running).", L, 1)
            cpu_max = read(d / "cpu.max")
            if cpu_max:
                quota, period = cpu_max.split()
                o.add("lab_guest_cgroup_cpu_max_cores", "cpu.max as cores (0: no cap).", L,
                      0 if quota == "max" else int(quota) / int(period))
            o.add("lab_guest_cgroup_cpu_weight", "cpu.weight: the guest's share of CPU when CPUs are contended "
                  "(100 default; twice the weight, twice the share).", L, limit(read(d / "cpu.weight")))
            o.add("lab_guest_cgroup_cpuset_cpus", "CPUs the guest's processes may run on (cpuset.cpus.effective).",
                  L, cpus(read(d / "cpuset.cpus.effective")) or None)
            for f, metric, h in (("memory.max", "memory_max_bytes", "memory.max: hard memory limit, OOM kill above it (0: none)."),
                                 ("memory.high", "memory_high_bytes", "memory.high: reclaim and throttle above it (0: none)."),
                                 ("memory.current", "memory_current_bytes", "memory.current: memory in use, page cache included."),
                                 ("memory.peak", "memory_peak_bytes", "memory.peak: the most it has used."),
                                 ("memory.swap.max", "swap_max_bytes", "memory.swap.max: swap limit (0: none)."),
                                 ("memory.swap.current", "swap_current_bytes", "memory.swap.current: swap in use."),
                                 ("pids.max", "pids_max", "pids.max: process and thread limit (0: none)."),
                                 ("pids.current", "pids_current", "pids.current: processes and threads.")):
                o.add(f"lab_guest_cgroup_{metric}", h, L, limit(read(d / f)))
            st = keyed(read(d / "cpu.stat"))
            o.add("lab_guest_cgroup_cpu_usage_seconds_total", "CPU time used.", L,
                  st.get("usage_usec", 0) / 1e6, "counter")
            o.add("lab_guest_cgroup_cpu_throttled_seconds_total", "Time held back by cpu.max.", L,
                  st.get("throttled_usec", 0) / 1e6, "counter")
            ev = keyed(read(d / "memory.events"))
            for e in ("high", "max", "oom", "oom_kill"):
                o.add("lab_guest_cgroup_memory_events_total", "memory.events: times it hit memory.high (high), "
                      "memory.max (max), and OOM kills.", {**L, "event": e}, ev.get(e, 0), "counter")
            for res in ("cpu", "memory", "io"):
                for line in (read(d / f"{res}.pressure") or "").splitlines():
                    kind_ = line.split()[0]
                    total = re.search(r"total=(\d+)", line)
                    if total:
                        o.add("lab_guest_cgroup_pressure_seconds_total", "Pressure stall time: some = at least one "
                              "task waited on the resource, full = all did.",
                              {**L, "resource": res, "kind": kind_}, int(total.group(1)) / 1e6, "counter")
    for dev in sorted(p.name for p in Path("/sys/class/block").iterdir()):
        base = Path("/sys/class/block") / dev
        if dev.startswith(("loop", "ram", "zram", "nbd", "sr")) or (base / "partition").exists():
            continue                                      # node_exporter leaves these out too
        owner, what = what_is(read(base / "dm" / "name") or dev, names)
        if dev in mounts:
            what = mounts[dev]
        o.add("lab_host_block_device_info", "Every pve01 disk device and what it is (value always 1).",
              {"device": dev, "owner": owner, "what": what}, 1)
    tmp = OUT.with_name(f".{OUT.name}.tmp")
    tmp.write_text(o.text())
    os.chmod(tmp, 0o644)
    tmp.replace(OUT)                                      # node_exporter never reads half a file


if __name__ == "__main__":
    main()
