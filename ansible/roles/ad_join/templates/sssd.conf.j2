# Managed by Ansible (ad_join role)
[sssd]
domains = {{ ad_domain }}
services = nss, pam

[domain/{{ ad_domain }}]
id_provider = ad
ad_domain = {{ ad_domain }}
krb5_realm = {{ ad_realm }}

# RFC2307: take UID/GID numbers from AD (uidNumber/gidNumber), so a user has the
# same UID on every machine and on NFS. (True would compute them from SIDs instead.)
ldap_id_mapping = False

# Log in as "alice", not "alice@ad.lab.internal"
use_fully_qualified_names = False
fallback_homedir = /home/%u
default_shell = /bin/bash

# Let users log in from cached credentials if the DC is unreachable
cache_credentials = True

# Clients never write DNS. The DHCP server (dnsmasq on dc01, as svc-dhcp-dns)
# registers A + PTR for every lease, so it owns all workstation records.
dyndns_update = False

# Who may log in on this machine: admins everywhere, plus the user groups for its role
access_provider = simple
simple_allow_groups = {{ ad_login_groups | join(', ') }}
