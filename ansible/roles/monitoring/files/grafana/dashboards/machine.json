   "title": "Proxmox's view of this VM",
   "description": "The same machine from the hypervisor's side (pve-exporter). Inside and outside should agree; when the guest is down this still shows whether the VM is spinning.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
