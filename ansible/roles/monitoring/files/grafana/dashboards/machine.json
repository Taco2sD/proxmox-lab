{
 "uid": "lab-machine",
 "title": "Machine",
 "description": "One machine in detail: server or workstation. Pick it at the top, or click a name on the Lab overview.",
 "tags": [
  "lab"
 ],
 "timezone": "browser",
 "editable": false,
 "graphTooltip": 1,
 "refresh": "30s",
 "schemaVersion": 41,
 "version": 1,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "timepicker": {
  "refresh_intervals": [
   "15s",
   "30s",
   "1m",
   "5m",
   "15m"
  ]
 },
 "templating": {
  "list": [
   {
    "name": "host",
    "label": "Machine",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "hide": 0,
    "query": {
     "query": "query_result(max by (host) (up{job=~\"servers|workstations\"}))",
     "refId": "vars",
     "qryType": 3
    },
    "definition": "query_result(max by (host) (up{job=~\"servers|workstations\"}))",
    "regex": "/host=\"([^\"]+)\"/",
    "refresh": 2,
    "sort": 1
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "links": [
  {
   "title": "Portal admin",
   "type": "link",
   "url": "/admin",
