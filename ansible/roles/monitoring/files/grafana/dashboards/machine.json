  ]
 },
 "templating": {
  "list": [
   {
    "name": "host",
    "label": "Machine",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "hide": 0,
    "query": {
     "query": "query_result(max by (host) (up{job=~\"servers|workstations\"}))",
