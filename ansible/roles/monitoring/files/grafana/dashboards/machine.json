 "panels": [
  {
   "id": 21,
   "type": "stat",
   "title": "Kind",
   "description": "Virtual machine: its own kernel on emulated hardware (KVM). Container: a group of processes on pve01's own kernel, fenced in by namespaces and cgroups. Proxmox host: pve01, itself a Hyper-V VM on the Windows host. Read from pve01 (lab-guest-metrics), because a container can't tell: it even sees pve01's hardware (DMI) as its own.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(max(lab_guest_config_info{guest=\"$host\",type=\"qemu\"}) * 1) or (max(lab_guest_config_info{guest=\"$host\",type=\"lxc\"}) * 2) or (max(node_dmi_info{host=\"$host\"}) * 3)",
     "refId": "A",
     "legendFormat": "__auto",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "Virtual machine",
         "color": "blue",
         "index": 0
        },
        "2": {
         "text": "Container",
         "color": "orange",
         "index": 1
        },
        "3": {
         "text": "Proxmox host",
         "color": "purple",
         "index": 2
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "auto",
    "orientation": "auto",
    "wideLayout": true,
    "showPercentChange": false
   }
  },
  {
   "id": 22,
   "type": "stat",
   "title": "Isolation",
   "description": "How the machine is separated from the others. Unprivileged container: root inside is an ordinary user on pve01. nesting: may run its own containers (Docker on mgmt01).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 5,
    "y": 0,
    "w": 10,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "lab_guest_config_info{guest=\"$host\"}",
     "refId": "A",
     "legendFormat": "{{isolation}}",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "node_dmi_info{host=\"$host\"} unless on() lab_guest_config_info{guest=\"$host\"}",
     "refId": "B",
     "legendFormat": "The hypervisor: a {{system_vendor}} {{product_name}} (Hyper-V), running KVM nested",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "name",
    "justifyMode": "auto",
    "orientation": "auto",
    "wideLayout": true,
    "showPercentChange": false
   }
  },
