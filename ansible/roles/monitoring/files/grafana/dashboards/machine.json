  {
   "id": 10,
   "type": "timeseries",
   "title": "CPU",
   "description": "Busy time by kind, as a share of all cores. iowait: waiting on disk; steal: the hypervisor gave the time to another VM.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (mode) (rate(node_cpu_seconds_total{host=\"$host\",mode!=\"idle\"}[$__rate_interval])) / scalar(count(node_cpu_seconds_total{host=\"$host\",mode=\"idle\"}))",
     "refId": "A",
     "legendFormat": "{{mode}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 70,
      "gradientMode": "none",
      "showPoints": "never",
      "spanNulls": false,
      "lineInterpolation": "smooth",
      "axisSoftMin": 0,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Memory",
   "description": "Used is what programs hold; cache is what the kernel gives back when they need it.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "node_memory_MemTotal_bytes{host=\"$host\"} - node_memory_MemAvailable_bytes{host=\"$host\"}",
     "refId": "A",
     "legendFormat": "used"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "node_memory_MemAvailable_bytes{host=\"$host\"} - node_memory_MemFree_bytes{host=\"$host\"}",
     "refId": "B",
     "legendFormat": "cache (reclaimable)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "node_memory_MemTotal_bytes{host=\"$host\"}",
     "refId": "C",
     "legendFormat": "total"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "node_memory_SwapTotal_bytes{host=\"$host\"} - node_memory_SwapFree_bytes{host=\"$host\"}",
     "refId": "D",
     "legendFormat": "swap used"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 70,
      "gradientMode": "none",
      "showPoints": "never",
      "spanNulls": false,
      "lineInterpolation": "smooth",
      "axisSoftMin": 0,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "total"
      },
      "properties": [
       {
        "id": "custom.stacking",
        "value": {
         "mode": "none",
         "group": "A"
        }
       },
       {
        "id": "custom.fillOpacity",
        "value": 0
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          10
         ]
        }
       },
       {
        "id": "custom.lineWidth",
        "value": 2
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#8e8e8e"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "swap used"
      },
      "properties": [
       {
        "id": "custom.stacking",
        "value": {
         "mode": "none"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       },
       {
        "id": "custom.fillOpacity",
        "value": 0
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 12,
   "type": "bargauge",
   "title": "Filesystems",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "1 - node_filesystem_avail_bytes{host=\"$host\",fstype!~\"tmpfs|ramfs|squashfs|overlay|efivarfs|fuse.*\"} / node_filesystem_size_bytes{host=\"$host\",fstype!~\"tmpfs|ramfs|squashfs|overlay|efivarfs|fuse.*\"}",
     "refId": "A",
     "legendFormat": "{{mountpoint}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.75
       },
       {
        "color": "red",
        "value": 0.9
       }
      ]
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true,
    "valueMode": "color",
    "namePlacement": "top",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Disk I/O",
   "description": "Reads up, writes down.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (device) (rate(node_disk_read_bytes_total{host=\"$host\"}[$__rate_interval])) > 0",
     "refId": "A",
     "legendFormat": "{{device}} read"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "-sum by (device) (rate(node_disk_written_bytes_total{host=\"$host\"}[$__rate_interval])) < 0",
     "refId": "B",
     "legendFormat": "{{device}} write"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": false,
      "lineInterpolation": "smooth",
      "axisSoftMin": 0,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Network",
   "description": "Received up, sent down.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(node_network_receive_bytes_total{host=\"$host\",device!~\"lo|veth.*|docker.*|br-.*|tap.*|fwln.*|fwpr.*|fwbr.*\"}[$__rate_interval]) > 0",
     "refId": "A",
     "legendFormat": "{{device}} in"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "-rate(node_network_transmit_bytes_total{host=\"$host\",device!~\"lo|veth.*|docker.*|br-.*|tap.*|fwln.*|fwpr.*|fwbr.*\"}[$__rate_interval]) < 0",
