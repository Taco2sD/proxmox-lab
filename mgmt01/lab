#!/bin/bash
# lab: the one entry point for changing the lab's workstation fleet. Runs on mgmt01.
#
#   lab plan            show what would change (read-only)
#   lab apply           make the lab match inventory/workstations.yml
#   lab reimage <host>  rebuild one workstation from scratch (keeps its AD account and role)
#   lab prune           delete AD accounts and host records of workstations removed from the inventory
#
# Always works from the latest commit on GitHub. Set LAB_YES=1 to skip confirmations.
set -euo pipefail

REPO=/opt/proxmox-lab
cd "$REPO"
git pull -q --ff-only

set -a; . /etc/proxmox-lab/tofu.env; set +a        # Proxmox API token (root-only file)
export ANSIBLE_CONFIG="$REPO/ansible.cfg"

ap() { ansible-playbook -i ansible/infra/hosts.yml "$@"; }
tf() { tofu -chdir=terraform "$@"; }
inventory_hosts() {   # workstations.yml + inventory/guests/*.yml
  python3 - <<'PY'
import glob, yaml
hosts = set(yaml.safe_load(open("inventory/workstations.yml"))["workstations"])
for f in glob.glob("inventory/guests/*.yml"):
    hosts |= set((yaml.safe_load(open(f)) or {}).keys())
print("\n".join(sorted(hosts)))
PY
}
vm_hosts() {
  tf state list 2>/dev/null | sed -n 's/^proxmox_virtual_environment_vm\.workstation\["\(.*\)"\]$/\1/p' | sort
}
confirm() {   # confirm <word>: the user must type <word>
  [ "${LAB_YES:-}" = 1 ] && return 0
  read -rp "Type '$1' to continue: " answer
  [ "$answer" = "$1" ] || { echo "lab: not confirmed, nothing changed"; exit 1; }
}

case "${1:-}" in
  plan)
    tf init -input=false >/dev/null
    tf plan
    ;;

  apply)
    tf init -input=false >/dev/null
    tf plan -out=lab.tfplan >/dev/null
    tf show lab.tfplan | tail -n 1
    tf show -no-color lab.tfplan | grep -E '^  # .* will be' || true
    confirm apply
    ap ansible/infra.yml                                # AD accounts, DHCP reservations, host records
    for h in $(comm -23 <(inventory_hosts) <(vm_hosts)); do
      echo "==> $h is new: one-time join password"
      ap ansible/otp.yml -e host="$h"
    done
    tf apply lab.tfplan                                 # VMs: new ones PXE-boot and install themselves
    rm -f terraform/lab.tfplan
    ;;

  reimage)
    h=${2:?usage: lab reimage <host>}
    inventory_hosts | grep -qx "$h" || { echo "lab: '$h' is not in inventory/workstations.yml" >&2; exit 1; }
    tf init -input=false >/dev/null
    tf plan -replace="proxmox_virtual_environment_vm.workstation[\"$h\"]" -out=lab.tfplan >/dev/null
    echo "This destroys $h's VM and disk and installs it again from scratch."
    confirm "$h"                                        # before the OTP: resetting it ends $h's domain membership
    ap ansible/infra.yml
    ap ansible/otp.yml -e host="$h"
    tf apply lab.tfplan
    rm -f terraform/lab.tfplan
    ;;

  prune)
    echo "Deletes AD computer accounts and autoinstall records of workstations not in the inventory."
    confirm prune
    ap ansible/infra.yml -e prune=true
    ;;

  *)
    sed -n '4,9p' "$0"
    exit 1
    ;;
esac
