# Self-service portal, web side (mgmt01/portal/portal.py). Unprivileged: it can only
# queue requests and read their status; the worker does everything else.
[Unit]
Description=Lab self-service portal (web)
After=network-online.target

[Service]
User=labportal
Group=labportal
Environment=LAB_PORTAL_MAX_GUESTS=4
ExecStart=/usr/bin/python3 /usr/local/lib/lab-portal/portal.py
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/lab-portal/requests /var/lib/lab-portal/passwords

[Install]
WantedBy=multi-user.target
