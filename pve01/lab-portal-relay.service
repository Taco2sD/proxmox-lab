# /etc/systemd/system/lab-portal-relay.service on pve01 (see lab-portal-relay.socket)
[Unit]
Description=Relay the self-service portal from the tunnel to mgmt01
Requires=lab-portal-relay.socket
After=lab-portal-relay.socket

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 10.10.10.6:8443
DynamicUser=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
