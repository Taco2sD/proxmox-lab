#!/bin/bash
# /usr/local/sbin/provision-ws on pve01
#
#   provision-ws <hostname>
#
# (Re)image a lab workstation with nobody touching it or seeing a secret.
# This is the lab's stand-in for a provisioning server (KACE SDA, MAAS, ...).
# pve01 already has root on dc01 (guest agent) and mgmt01 (pct), so it needs
# no extra credentials. In production: a provisioning server with a service
# account delegated rights over OU=Workstations.
#
#   1. dc01:   reset the pre-staged computer account to a fresh one-time password
#   2. mgmt01: rebuild the host record (user-data, meta-data, otp) and allow only
#              the host's reserved IP to fetch its otp
#   3. pve01:  give the VM a blank disk and boot it -> PXE -> autoinstall
#              -> first boot: ansible-pull joins AD and applies the AD-assigned role
#
# Prerequisites (deliberate admin decisions, not automated here):
#   - a VM with this name, and a DHCP reservation for its MAC on dc01
#   - a pre-staged computer account in AD, member of its role-* group
set -euo pipefail

DC_VMID=105
MGMT_CT=106
WEB=/var/www/html/autoinstall
INSTALL_MEM=5120                       # netboot holds the ISO in RAM; shrink after install
# The autoinstall template comes from GitHub (the source of truth), fresh for every build
TEMPLATE_URL=https://raw.githubusercontent.com/Taco2sD/proxmox-lab/main/mgmt01/template.yaml
DISK="local-lvm:24,discard=on,ssd=1,iothread=1"

host=${1:?usage: provision-ws <hostname>}
die()  { echo "provision-ws: $*" >&2; exit 1; }
step() { echo "==> $*"; }

# Run a command as root on dc01 via the guest agent; pass through output and exit code.
dc() {
  qm guest exec "$DC_VMID" --timeout 60 "$@" | python3 -c '
import sys, json
d = json.load(sys.stdin)
sys.stdout.write(d.get("out-data", "")); sys.stderr.write(d.get("err-data", ""))
sys.exit(d.get("exitcode", 1))'
}

# ---- Look up what we're about to provision ----------------------------------
vmid=$(qm list | awk -v h="$host" '$2 == h {print $1}')
[ -n "$vmid" ] || die "no VM named '$host'"
mac=$(qm config "$vmid" | sed -n 's/^net0: [a-z0-9]*=\([0-9A-Fa-f:]*\),.*/\1/p')
[ -n "$mac" ] || die "can't read the net0 MAC address of VM $vmid"
ip=$(dc -- grep -i "^dhcp-host=$mac," /etc/dnsmasq.d/lab-dhcp.conf | cut -d, -f2 || true)
[ -n "$ip" ] || die "no DHCP reservation for $mac on dc01: add it to lab-dhcp.conf first"
dc -- samba-tool computer show "$host" >/dev/null 2>&1 \
  || die "no computer account '$host' in AD: pre-stage it (and add it to a role-* group) first"

echo "$host: VM $vmid, MAC $mac, reserved IP $ip"
read -rp "This WIPES $host's disk and reinstalls it. Type the hostname to confirm: " answer
[ "$answer" = "$host" ] || die "not confirmed, nothing changed"

# ---- 1. AD: fresh one-time password -----------------------------------------
otp=$(openssl rand -base64 18 | tr -d '/+=')
step "dc01: reset ${host^^}\$ to a fresh one-time password"
dc --pass-stdin 1 -- bash -c 'read -r p; samba-tool user setpassword "$0\$" --newpassword="$p" >/dev/null' "$host" <<<"$otp"

# ---- 2. mgmt01: host record + OTP + nginx ACL --------------------------------
step "mgmt01: host record for $host (template from GitHub); its otp readable only from $ip"
template=$(curl -fsS "$TEMPLATE_URL") || die "can't fetch the autoinstall template from $TEMPLATE_URL"
pct exec "$MGMT_CT" -- bash -c '
  set -e
  host=$1 ip=$2 mac=$3 web=$4
  mkdir -p "$web/$host"
  sed -e "s|__HOSTNAME__|$host|g" \
      -e "s|__PWHASH__|$(cat /root/provision/labadmin.hash)|" \
      -e "s|__SSHKEY__|$(cat /root/pvelab.pub)|" \
      > "$web/$host/user-data"          # template arrives on stdin
  echo "instance-id: $host-$(date +%s)" > "$web/$host/meta-data"
  ln -sfn "$host" "$web/$mac"
  map=/etc/nginx/autoinstall-otp.map
  touch "$map"
  { grep -v "^/autoinstall/$host/otp " "$map" || true; echo "/autoinstall/$host/otp $ip;"; } > "$map.new"
  mv "$map.new" "$map"
  nginx -t -q && systemctl reload nginx
' _ "$host" "$ip" "${mac,,}" "$WEB" <<<"$template"
pct exec "$MGMT_CT" -- sh -c 'umask 027; cat > "$0"; chgrp www-data "$0"' "$WEB/$host/otp" <<<"$otp"
unset otp

# ---- 3. pve01: blank disk, boot ----------------------------------------------
step "pve01: blank disk for VM $vmid"
qm stop "$vmid" >/dev/null 2>&1 || true
qm disk unlink "$vmid" --idlist scsi0 --force >/dev/null
# unlink also drops scsi0 from the boot order, so set it explicitly: disk first,
# then network. The blank disk falls through to PXE once; after the install the
# disk wins. Without this the VM PXE-boots after every install: a reinstall loop.
qm set "$vmid" --scsi0 "$DISK" --boot 'order=scsi0;net0' --memory "$INSTALL_MEM" >/dev/null

step "booting $host: PXE -> autoinstall -> first boot: join AD + apply its role"
qm start "$vmid"
cat <<EOF

Watch it on the Proxmox console of VM $vmid. When it's back at a login prompt:
  - on your PC:  ssh-keygen -R $host; ssh-keygen -R $ip    (it has new SSH host keys)
  - shrink RAM:  qm shutdown $vmid && qm set $vmid --memory 2048 && qm start $vmid
EOF
